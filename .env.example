# ==========================================
# Patricia Project — Environment Variables (Plantilla)
# ==========================================

# Supabase Cloud Configuration
SUPABASE_PROJECT_REF=your_supabase_project_ref
SUPABASE_URL=https://your_supabase_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Database Direct Connection
SUPABASE_DB_PASSWORD=your_db_password
DATABASE_URL=postgresql://postgres:your_db_password@db.your_supabase_project_ref.supabase.co:5432/postgres

# AI Assistant LLM Provider (Google Gemini)
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key

# Server Port
PORT=3002

# Deployment Server (Visar)
VISAR_HOST=159.203.103.8
VISAR_USER=root
VISAR_DOMAIN=patricia.vis7ar.com
VISAR_API_DOMAIN=api.patricia.vis7ar.com
