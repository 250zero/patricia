[Unit]
Description=Patricia Deno Backend API (Hono)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/patricia.vis7ar.com/backend
EnvironmentFile=/var/www/patricia.vis7ar.com/backend/.env
ExecStart=/root/.deno/bin/deno run --allow-net --allow-env --allow-read --allow-write main.ts
Restart=always
RestartSec=3
Environment=PORT=3002
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
